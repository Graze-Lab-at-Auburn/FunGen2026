########################  Login to Alabama Super computer
ssh my_name@asax.asc.edu

##Log in (example account shown - use your ID)
ssh aubrmg001@asax.asc.edu


########### PUSH file from Local computer to remote computer using the scp program ###########
## From Local computer to ASC (remote)
## Open terminal on local computer
## Log in to ASC in another tab of your terminal
## Determine the path to the file you want to transfer (local)
## Determine the path to the directory you are transferring to (remote)

## Command from your local machine
scp [options] source  user@host:destination
## Example 
scp /local/path/PracticeScript.sh  aubrmg001@asax.asc.edu:~FunGen/scripts/


######### PULL data using scp ###########
###From ASC (remote) to Local computer
## Open terminal on local computer
## Log in to ASC in another tab of your terminal
## Determine the path to the file you want to transfer (remote)
## Determine the path to the directory you are transferring to (local)

## Command from your local machine
scp [options] user@host:source destination

## Example 
scp aubrmg001@asax.asc.edu :~FunGen/scripts/PracticeScript.sh /local/path  


######### Push data using rsync ###########
## From Local computer to ASC (remote)
## Open terminal on local computer
## Log in to ASC in another tab of your terminal
## Determine the path to the file you want to transfer (local and remote)

# Open terminal on local computer 
# determine the path to the file you want to transfer
rsync --partial -arv <local path and file> <ID:remote path to target folder>

## examples to push from my computer to ASC or Hopper
rsync --partial -arv /Users/Graze/Desktop/scripts/*  aubrmg001@asax.asc.edu:/home/aubrmg001/scripts

######### PULL data using rsync
###From ASC (remote) to Local computer
rsync --partial -arv <ASC Login ID:path to remote file>  <path to local target folder>

## example
rsync --partial -arv aubrmg001@asax.asc.edu:/home/aubrmg001/graze_class/fastqc/*  /Users/Graze/Desktop/ClassData


################# Check accuracy of data transfers - typically when receiving data from a company or collaborator #######################
#On ASC 
md5sum <filename>

## To check all the files in a folder - this usually works from unix
md5sum ./*

## On mac
md5 <filename>

## On mac all files
find . -type f -exec md5  {} \; > md5_SeqCapMyLaptop.txt

## On windows - use WSL (see ASC) or see https://knowledge.illumina.com/software/general/software-general-reference_material-list/000008482
## 1. Press: Windows key + R, and type cmd
## 2. Use the file explorer to find the file and use Copy Address as Text (right click on the address bar) to get the path
## 3. Use cd to navigate to the directory (cd path\to\directory)
certutil -hashfile <filename> MD5

##################### Unzip a file
